{
  "name": "@local/dsh-local-superagent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local Superagent: a workspace task board where a superagent dispatches, reviews and advances tasks on its own, with minimal user interruption.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superchao5717/dsh-local-superagent.git"
  },
  "homepage": "https://github.com/superchao5717/dsh-local-superagent#readme",
  "bugs": {
    "url": "https://github.com/superchao5717/dsh-local-superagent/issues"
  },
  "keywords": ["dsh-plugin", "workflow", "superagent", "task-board"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js && node --check lib/api.js && node --check lib/engine.js && node --check lib/models.js && node --check lib/prompts.js && node --check lib/sessions.js && node --check lib/store.js && node --check lib/tools.js && node --check lib/util.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "docs/CONTRACT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
